// datasource for MySQL
 datasource db {
   provider = "mysql"
   url      = env("FUTURES_DATABASE_URL")
 }

// Prisma Client generator
 generator client {
   provider = "prisma-client-js"
   output   = "../../node_modules/@prisma/client-futures"
 }

enum AssetMode {
  SINGLE_ASSET
  MULTI_ASSET
}

model User {
  id            Int          @id @default(autoincrement())
  email         String       @unique
  assetMode     AssetMode    @default(SINGLE_ASSET)
  positionMode  PositionMode @default(ONE_WAY)
  createdAt     DateTime     @default(now())

  // Relations
  balances Balance[]
  positions Position[]
  positionSettings PositionSetting[]
}

model Pair {
  id        Int     @id @default(autoincrement())
  symbol    String  @unique
  baseAsset String
  quoteAsset String
  createdAt DateTime @default(now())

  // Relations
  positions Position[]
  positionSettings PositionSetting[]
}

model Currency {
  code String @id                // e.g. "BTC", "USDT"
  name String?
  symbol String?                 // optional display symbol
  createdAt DateTime @default(now())

  // Relations
  balances Balance[]
}

model Balance {
  id        Int     @id @default(autoincrement())
  userId    Int
  currencyCode String
  margin       Decimal  @db.Decimal(40, 18)          // margin balance
  available    Decimal  @db.Decimal(40, 18)          // free balance
  locked       Decimal  @db.Decimal(40, 18)          // reserved for open orders
  updatedAt    DateTime @updatedAt

  // Relations
  user     User     @relation(fields: [userId], references: [id])
  currency Currency @relation(fields: [currencyCode], references: [code])

  @@unique([userId, currencyCode])
}

enum PositionSide {
  LONG
  SHORT
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum PositionMode {
  ONE_WAY
  HEDGE
}

enum MarginMode {
  ISOLATED
  CROSS
}

model Position {
  id        Int     @id @default(autoincrement())
  userId    Int
  pairId    Int
  positionSide PositionSide
  positionStatus PositionStatus
  qty Decimal  @db.Decimal(40, 18)
  entryPrice Decimal  @db.Decimal(40, 18)
  // unrealizedPnl Decimal  @db.Decimal(40, 18)
  isolatedMargin Decimal  @db.Decimal(40, 18)
  leverage Decimal  @db.Decimal(40, 18)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])
  pair Pair @relation(fields: [pairId], references: [id])
}

model PositionSetting {
  id         Int        @id @default(autoincrement())
  userId     Int
  pairId     Int
  marginMode MarginMode @default(CROSS)
  leverage   Decimal    @db.Decimal(10, 2) @default(1.00)

  // Relations
  user User @relation(fields: [userId], references: [id])
  pair Pair @relation(fields: [pairId], references: [id])

  @@unique([userId, pairId])
}


